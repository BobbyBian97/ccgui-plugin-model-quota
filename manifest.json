{
  "id": "model-quota",
  "name": "模型额度胶囊",
  "version": "0.2.1",
  "minAppVersion": "1.1.9",
  "author": "BobbyBian97",
  "description": "在输入框状态栏用胶囊显示当前会话模型所在渠道的 5 小时 / 周 / 月额度（已用百分比，悬浮看剩余），支持智谱 GLM Coding Plan 与 OpenCode Go。",
  "repo": "BobbyBian97/ccgui-plugin-model-quota",
  "tier": "js",
  "license": "MIT",
  "sdkVersion": ">=0.3.24",
  "permissions": [
    "ui:composer-status",
    "ui:settings-section",
    "storage",
    "events",
    "network:open.bigmodel.cn",
    "network:api.z.ai",
    "network:opencode.ai"
  ],
  "keywords": [
    "quota",
    "usage",
    "glm",
    "opencode",
    "额度",
    "用量"
  ]
}
